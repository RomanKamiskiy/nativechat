{
  "name": "nativechat",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @nativechat/api",
    "dev:web": "npm run dev -w @nativechat/web",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker-compose up -d"
  }
}
