{
  "name": "nativechat",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nativechat",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@nativechat/api",
      "version": "1.0.0"
    },
    "apps/web": {
      "name": "@nativechat/web",
      "version": "1.0.0"
    },
    "node_modules/@nativechat/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@nativechat/react-sdk": {
      "resolved": "packages/react-sdk",
      "link": true
    },
    "node_modules/@nativechat/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/@nativechat/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/react-sdk": {
      "name": "@nativechat/react-sdk",
      "version": "1.0.0"
    },
    "packages/shared-types": {
      "name": "@nativechat/shared-types",
      "version": "1.0.0"
    }
  }
}
