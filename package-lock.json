{
  "name": "nativechat",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nativechat",
      "version": "0.0.1",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@nativechat/api",
      "version": "0.0.1",
      "dependencies": {
        "@nativechat/shared-types": "*"
      }
    },
    "apps/web": {
      "name": "@nativechat/web",
      "version": "0.0.1",
      "dependencies": {
        "@nativechat/react-sdk": "*",
        "@nativechat/shared-types": "*"
      }
    },
    "node_modules/@nativechat/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@nativechat/react-sdk": {
      "resolved": "packages/react-sdk",
      "link": true
    },
    "node_modules/@nativechat/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/@nativechat/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/react": {
      "version": "19.2.8",
      "resolved": "https://registry.npmjs.org/react/-/react-19.2.8.tgz",
      "integrity": "sha512-PWaYA1L/q9u2u7xYQi+Y3L3Yfnie7XyLeaJICV1MGD6LprsBxcAqGjYyr0eY3p+QdsA+x/Irkt4Qif8D63+Sbw==",
      "license": "MIT",
      "peer": true,
      "engines": {
        "node": ">=0.10.0"
      }
    },
    "packages/react-sdk": {
      "name": "@nativechat/react-sdk",
      "version": "0.0.1",
      "dependencies": {
        "@nativechat/shared-types": "*"
      },
      "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
      }
    },
    "packages/shared-types": {
      "name": "@nativechat/shared-types",
      "version": "0.0.1"
    }
  }
}
