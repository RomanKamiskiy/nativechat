DATABASE_URL="postgresql://postgres:password@localhost:5432/nativechat"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="super-secret-nativechat-key"

# Limited platform tokens for one-shot product auto-tune (not chat)
# SETUP_TOKEN_BUDGET=8000
# TEMP local E2E: skip setup-token gates + report tokensLeft: 9999999
# DISABLE_TOKEN_LIMITS=true

# Optional: real free GPT Mini / LLM polish (platform-paid). Without it, heuristic demo is used.
# OPENAI_API_KEY=
# FREE_MINI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required for RAG (Epic 8): embeddings + grounded answers
# Get a free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMS=768
# GEMINI_CHAT_MODEL=gemini-flash-latest
# RAG_SIMILARITY_THRESHOLD=0.5

# Telegram Bot (set webhook to https://YOUR_HOST/api/telegram/webhook)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=your_bot
# TELEGRAM_PAYMENT_URL=https://t.me/your_bot
