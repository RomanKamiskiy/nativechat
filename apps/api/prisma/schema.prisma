generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  /// free_mini | mcp — BYO agent to avoid platform token tariffs
  agentProvider String         @default("free_mini")
  mcpServerUrl  String?
  mcpToolName   String         @default("chat")
  /// Optional bearer token for the customer's MCP agent (stored server-side only)
  mcpAuthToken  String?

  /// Limited platform tokens ONLY for one-shot product auto-tune (not chat)
  setupTokenBudget Int         @default(8000)
  setupTokensUsed  Int         @default(0)
  setupCompletedAt DateTime?
  productUrl       String?
  productName      String?
  /// Design tokens produced by auto-tune (colors, radius, fonts…)
  themeTokens      Json?
  welcomeMessage   String?     @db.Text

  users         User[]
  conversations Conversation[]
}

model User {
  id            String         @id @default(uuid())
  externalId    String?        
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  /// user | admin | bot — used by dashboard/widget bubble alignment
  role          String         @default("user")
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  messages      Message[]
  participations Participant[]

  @@unique([projectId, externalId])
}

model Conversation {
  id            String         @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  messages      Message[]
  participants  Participant[]
}

model Participant {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String        @default("member") 
  joinedAt       DateTime      @default(now())

  @@unique([userId, conversationId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String        @db.Text
  type           String        @default("text")
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
